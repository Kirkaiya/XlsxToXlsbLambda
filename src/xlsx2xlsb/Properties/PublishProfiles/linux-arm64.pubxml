<?xml version="1.0" encoding="utf-8"?>
<!--
  The agent image's build of xlsx2xlsb. Bedrock AgentCore runs linux/arm64 only.
  Self-contained (no .NET runtime in the image), ReadyToRun (precompiled, so a cold
  conversion does not pay for JIT), deliberately NOT trimmed (OpenXml uses reflection).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\linux-arm64\</PublishDir>
  </PropertyGroup>
</Project>
