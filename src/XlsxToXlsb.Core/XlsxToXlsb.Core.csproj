<Project Sdk="Microsoft.NET.Sdk">
  <!-- The conversion itself, shared by the Lambda and the xlsx2xlsb CLI. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XlsxToXlsb</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XlsxToXlsbLambda.Tests" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="OfficeIMO.Excel" Version="3.6.1" />
  </ItemGroup>
</Project>
